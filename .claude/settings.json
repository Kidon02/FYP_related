{
  "enabledPlugins": {
    "commit-commands@anthropic-plugin-directory": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud_autocommit.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && pip install -r \"$CLAUDE_PROJECT_DIR/requirements.txt\" || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
